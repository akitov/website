modules = ["nodejs-24", "python-3.11"]

[deployment]
deploymentTarget = "static"
publicDir = "artifacts/personal-site"

[workflows]
runButton = "Personal Site Preview"

[[workflows.workflow]]
name = "Personal Site Preview"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 artifacts/personal-site/server.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80
